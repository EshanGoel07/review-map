# Review Map: LLM settings.
# Copy this file to `.env` and fill in ONE provider's key. `.env` is gitignored.
# Without any key, Review Map still works in a heuristic (no-LLM) mode.
# (The LLM layer itself is built in Phase 4; variable names may be refined then.)

# --- Default: Groq (free tier, OpenAI-compatible) ---------------------------
# Get a key at https://console.groq.com/keys
REVIEW_MAP_LLM_PROVIDER=groq
REVIEW_MAP_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Free fallback: Google Gemini (OpenAI-compatible endpoint) ---------------
# Get a key at https://aistudio.google.com/apikey
# REVIEW_MAP_LLM_PROVIDER=gemini
# REVIEW_MAP_LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# --- Anthropic (official SDK) ------------------------------------------------
# REVIEW_MAP_LLM_PROVIDER=anthropic
# REVIEW_MAP_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# --- OpenAI ------------------------------------------------------------------
# REVIEW_MAP_LLM_PROVIDER=openai
# REVIEW_MAP_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Ollama (local, free, offline; run `ollama serve` first) ----------------
# REVIEW_MAP_LLM_PROVIDER=ollama
# REVIEW_MAP_LLM_MODEL=llama3.1:8b
# REVIEW_MAP_LLM_BASE_URL=http://localhost:11434/v1

# --- GitHub (optional for public reads; required to post PR comments) --------
# GITHUB_TOKEN=
